# Local development values only. Replace these before exposing any service.
MSSQL_SA_PASSWORD=LocalDevPassword123!
RABBITMQ_DEFAULT_USER=cnpm
RABBITMQ_DEFAULT_PASS=local-dev-rabbitmq-password

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Local Administrator
BOOTSTRAP_ADMIN_PASSWORD=Admin12345!
DEMO_MODE=false

# One caller token per service identity. Keep each value distinct.
AUTH_SERVICE_TOKEN=local-dev-auth-caller-token-change-me
CONTENT_SERVICE_TOKEN=local-dev-content-caller-token-change-me
NARRATION_SERVICE_TOKEN=local-dev-narration-caller-token-change-me
TRANSLATION_SERVICE_TOKEN=local-dev-translation-caller-token-change-me
TTS_SERVICE_TOKEN=local-dev-tts-caller-token-change-me
GATEWAY_SERVICE_TOKEN=local-dev-gateway-caller-token-change-me

STORAGE_SIGNING_SECRET=local-dev-signing-secret-change-me-32-characters
OBJECT_STORAGE_PATH=.local-data/audio
OBJECT_STORAGE_PUBLIC_URL=http://localhost:8085

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=cnpm
RABBITMQ_PASSWORD=local-dev-rabbitmq-password
