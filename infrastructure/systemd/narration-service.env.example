SERVER_PORT=8082
DB_URL=jdbc:sqlserver://127.0.0.1:1433;databaseName=narration_db;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=replace-with-the-local-sql-server-password
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=replace-with-the-local-rabbitmq-password
GATEWAY_SERVICE_TOKEN=replace-with-the-same-gateway-secret-as-api-gateway
NARRATION_SERVICE_TOKEN=replace-with-a-long-random-secret-for-narration-service
APP_MOCKS_ENABLED=false
CONTENT_SERVICE_URL=http://127.0.0.1:8083
TRANSLATION_SERVICE_URL=http://127.0.0.1:8084
TTS_SERVICE_URL=http://127.0.0.1:8085
API_GATEWAY_URL=http://127.0.0.1:8080
