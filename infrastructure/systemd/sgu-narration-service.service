[Unit]
Description=SGU Narration Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sgu
Group=sgu
WorkingDirectory=/opt/sgu/narration-service
EnvironmentFile=/etc/sgu/narration-service.env
ExecStart=/usr/bin/java -jar /opt/sgu/narration-service/current/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
