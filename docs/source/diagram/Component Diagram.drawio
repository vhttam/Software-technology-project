<mxfile host="app.diagrams.net">
  <diagram name="Trang-1" id="l3BMuLXhxdEfmURo2X4v">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TB\n    %% ===== Lớp Client =====\n    subgraph Clients [\&quot;Lớp Client\&quot;]\n        Client[\&quot;Client App&lt;br/&gt;(Web React.js / Mobile React Native)\&quot;]\n    end\n\n    %% ===== Tầng Cổng Giao Tiếp =====\n    subgraph GatewayLayer [\&quot;Tầng Cổng Giao Tiếp (Reverse Proxy &amp; Router)\&quot;]\n        Gateway[\&quot;API Gateway\&quot;]\n        JWT[\&quot;JWT Validator&lt;br/&gt;(Stateless, RS256 Public Key)\&quot;]\n        SSE[\&quot;SSE Manager&lt;br/&gt;(Stream tiến độ job theo jobId)\&quot;]\n        Gateway --- JWT\n        Gateway --- SSE\n    end\n\n    %% ===== Tầng Backend Services =====\n    subgraph Services [\&quot;Tầng Backend Services\&quot;]\n        Auth[\&quot;Auth Service&lt;br/&gt;(RBAC, Token Issuer, User Mgmt)\&quot;]\n        Content[\&quot;Content Service&lt;br/&gt;(POI &amp; Immutable Version Content)\&quot;]\n        Narration[\&quot;Narration Service&lt;br/&gt;(Job Orchestrator &amp; State Machine)\&quot;]\n        Translation[\&quot;Translation Service&lt;br/&gt;(Chunking &amp; Text Translator)\&quot;]\n        TTS[\&quot;TTS Service&lt;br/&gt;(Voice Synthesizer &amp; Signed URL Gen)\&quot;]\n    end\n\n    %% ===== Message Broker =====\n    subgraph Broker [\&quot;Hạ Tầng Message Broker (RabbitMQ)\&quot;]\n        Events{{\&quot;narration.events&lt;br/&gt;(Topic Exchange - Durable)\&quot;}}\n        Cancel{{\&quot;narration.cancel&lt;br/&gt;(Fanout Exchange)\&quot;}}\n        \n        Q1[\&quot;translation.q.requested&lt;br/&gt;(Durable Queue)\&quot;]\n        Q2[\&quot;tts.q.translation-completed&lt;br/&gt;(Durable Queue)\&quot;]\n        Q3[\&quot;narration.q.translation-completed&lt;br/&gt;(Durable Queue)\&quot;]\n        Q4[\&quot;narration.q.results&lt;br/&gt;(Durable Queue)\&quot;]\n        \n        QCancelTrans[\&quot;Translation Instance Queue&lt;br/&gt;(Exclusive, Auto-delete)\&quot;]\n        QCancelTTS[\&quot;TTS Instance Queue&lt;br/&gt;(Exclusive, Auto-delete)\&quot;]\n\n        DLQ1[\&quot;DLQ: translation.q.requested\&quot;]\n        DLQ2[\&quot;DLQ: tts.q.translation-completed\&quot;]\n        DLQ3[\&quot;DLQ: narration.q.translation-completed\&quot;]\n        DLQ4[\&quot;DLQ: narration.q.results\&quot;]\n    end\n\n    %% ===== Tầng Dữ Liệu &amp; Lưu Trữ =====\n    subgraph Data [\&quot;Tầng Dữ Liệu &amp; Lưu Trữ\&quot;]\n        AuthDB[(\&quot;Auth DB&lt;br/&gt;(USERS)\&quot;)]\n        ContentDB[(\&quot;Content DB&lt;br/&gt;(POINTS_OF_INTEREST, CONTENTS)\&quot;)]\n        JobDB[(\&quot;Job DB&lt;br/&gt;(JOBS, JOB_TARGETS)\&quot;)]\n        TransDB[(\&quot;Translation DB&lt;br/&gt;(TRANSLATIONS)\&quot;)]\n        MediaDB[(\&quot;Media DB&lt;br/&gt;(AUDIOS)\&quot;)]\n        ObjStore[(\&quot;Object Storage&lt;br/&gt;(MP3 Audio Files)\&quot;)]\n        CancelState[(\&quot;Shared Durable Cancellation State&lt;br/&gt;(Lưu jobIds đã hủy: TTL &gt; DLQ retention,&lt;br/&gt;ví dụ: 48h nếu DLQ giữ tối đa 24h)\&quot;)]\n    end\n\n    %% ===== Dịch vụ bên thứ ba =====\n    subgraph External [\&quot;Dịch Vụ Bên Thứ Ba\&quot;]\n        TransProvider[\&quot;Third-party Translation Provider\&quot;]\n        TTSProvider[\&quot;Third-party TTS Provider\&quot;]\n    end\n\n    %% ===== Giao tiếp Client -&gt; Gateway &amp; Storage =====\n    Client --&gt;|\&quot;HTTPS / REST: Khách tham quan (/api/v1/client/** - No Auth)\&quot;| Gateway\n    Client --&gt;|\&quot;HTTPS / REST: Quản trị (Bearer JWT CONTENT_ADMIN)\&quot;| Gateway\n    SSE -.-&gt;|\&quot;SSE: GET /api/v1/jobs/{jobId}/events?accessToken=... \&quot;| Client\n    Client --&gt;|\&quot;HTTPS: Tải &amp; phát MP3 trực tiếp qua Signed URL\&quot;| ObjStore\n\n    %% ===== Gateway -&gt; Backend Services =====\n    Gateway --&gt;|\&quot;REST: /api/v1/auth/** &amp; GET /api/v1/auth/.well-known/jwks.json\&quot;| Auth\n    Gateway --&gt;|\&quot;REST: /api/v1/pois, /contents &amp; /internal/pois/** (X-Service-Token)\&quot;| Content\n    Gateway --&gt;|\&quot;REST: /api/v1/jobs, /voices &amp; /internal/narrations/** (X-Service-Token)\&quot;| Narration\n    Narration --&gt;|\&quot;POST /internal/callbacks/job-progress (X-Service-Token)\&quot;| Gateway\n\n    %% ===== REST nội bộ giữa các Service (X-Service-Token) =====\n    Narration --&gt;|\&quot;REST: GET /internal/contents/{id}/current\&quot;| Content\n    Narration --&gt;|\&quot;REST: GET /internal/voices &amp; /internal/audios/{id}/signed-url\&quot;| TTS\n    Narration --&gt;|\&quot;REST: GET /internal/translations/{id} (Lấy phụ đề)\&quot;| Translation\n    Translation --&gt;|\&quot;REST: GET /internal/contents/{id}/versions/{v}\&quot;| Content\n    TTS --&gt;|\&quot;REST: GET /internal/translations/{id} (Lấy text bản dịch)\&quot;| Translation\n\n    %% ===== Xuất bản sự kiện (Publish) =====\n    Content --&gt;|\&quot;Publish content.updated / content.deleted\&quot;| Events\n    Narration --&gt;|\&quot;Publish narration.requested (1 msg / target)\&quot;| Events\n    Narration --&gt;|\&quot;Publish narration.cancelled\&quot;| Cancel\n    Translation --&gt;|\&quot;Publish translation.completed / translation.failed\&quot;| Events\n    TTS --&gt;|\&quot;Publish tts.completed / tts.failed\&quot;| Events\n\n    %% ===== Binding Exchange -&gt; Queue =====\n    Events --&gt;|\&quot;routing: narration.requested\&quot;| Q1\n    Events --&gt;|\&quot;routing: translation.completed\&quot;| Q2\n    Events --&gt;|\&quot;routing: translation.completed\&quot;| Q3\n    Events --&gt;|\&quot;routing: translation.failed, tts.completed, tts.failed\&quot;| Q4\n    \n    Cancel --&gt;|\&quot;Broadcast\&quot;| QCancelTrans\n    Cancel --&gt;|\&quot;Broadcast\&quot;| QCancelTTS\n\n    %% ===== Tiêu thụ sự kiện (Consume) =====\n    Q1 --&gt;|\&quot;Consume narration.requested\&quot;| Translation\n    Q2 --&gt;|\&quot;Consume translation.completed\&quot;| TTS\n    Q3 --&gt;|\&quot;Consume translation.completed\&quot;| Narration\n    Q4 --&gt;|\&quot;Consume kết quả hoàn tất / lỗi\&quot;| Narration\n    \n    QCancelTrans --&gt;|\&quot;Nhận tín hiệu hủy job\&quot;| Translation\n    QCancelTTS --&gt;|\&quot;Nhận tín hiệu hủy job\&quot;| TTS\n\n    %% ===== Dead Letter Queue (DLQ) =====\n    Q1 --&gt;|\&quot;nack, requeue=false (Malformed / Invalid)\&quot;| DLQ1\n    Q2 --&gt;|\&quot;nack, requeue=false (Malformed / Invalid)\&quot;| DLQ2\n    Q3 --&gt;|\&quot;nack, requeue=false (Malformed / Invalid)\&quot;| DLQ3\n    Q4 --&gt;|\&quot;nack, requeue=false (Malformed / Invalid)\&quot;| DLQ4\n\n    %% ===== Tương tác CSDL &amp; Trạng thái hủy bền vững =====\n    Auth --&gt; AuthDB\n    Content --&gt; ContentDB\n    Narration --&gt; JobDB\n    Translation --&gt; TransDB\n    TTS --&gt; MediaDB\n    TTS --&gt;|\&quot;Upload MP3 &amp; lưu objectKey (không lưu Signed URL)\&quot;| ObjStore\n    \n    Translation -.-&gt;|\&quot;Kiểm tra &amp; ghi nhận jobId đã hủy\&quot;| CancelState\n    TTS -.-&gt;|\&quot;Kiểm tra &amp; ghi nhận jobId đã hủy\&quot;| CancelState\n\n    %% ===== Tương tác Provider ngoài (Xử lý Retry theo BR-05) =====\n    Translation --&gt;|\&quot;HTTPS / REST (Retry max 3 lần sau lần đầu)\&quot;| TransProvider\n    TTS --&gt;|\&quot;HTTPS / REST (Retry max 3 lần sau lần đầu)\&quot;| TTSProvider&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nhqjtalwApti7WjqExuh-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
