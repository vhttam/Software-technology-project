  <diagram name="Trang-1" id="i96j7nYdHF_FbnF4_A5_">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TB\n    %% ===== Môi trường thành viên nhóm =====\n    subgraph DevEnv [\&quot;Môi Trường Thành Viên Nhóm (Developer Machine)\&quot;]\n        DevPC[\&quot;Máy Lập trình viên\&quot;]\n        DevOpsPC[\&quot;Máy DevOps Engineer\&quot;]\n        subgraph LocalRun [\&quot;Chạy ứng dụng cục bộ: java -jar &lt;service&gt;.jar\&quot;]\n            JRE[\&quot;Java Runtime Environment\&quot;]\n            JarGW[\&quot;api-gateway.jar&lt;br/&gt;(Stateless Gateway)\&quot;]\n            JarAuth[\&quot;auth-service.jar&lt;br/&gt;(Auth &amp; RBAC)\&quot;]\n            JarContent[\&quot;content-service.jar&lt;br/&gt;(POI &amp; Content)\&quot;]\n            JarNarr[\&quot;narration-service.jar&lt;br/&gt;(Job Orchestration)\&quot;]\n            JarTrans[\&quot;translation-service.jar&lt;br/&gt;(Text Translation)\&quot;]\n            JarTTS[\&quot;tts-service.jar&lt;br/&gt;(Audio &amp; Speech)\&quot;]\n            \n            JRE --- JarGW\n            JRE --- JarAuth\n            JRE --- JarContent\n            JRE --- JarNarr\n            JRE --- JarTrans\n            JRE --- JarTTS\n        end\n    end\n\n    %% ===== Hạ tầng GitHub =====\n    subgraph GitHub [\&quot;Hạ Tầng GitHub (CI/CD Platform)\&quot;]\n        subgraph Repo [\&quot;GitHub Repository\&quot;]\n            PR[\&quot;Branches / Pull Requests&lt;br/&gt;(Branch Protection trên main:&lt;br/&gt;chỉ merge khi PR CI xanh)\&quot;]\n            Releases[\&quot;GitHub Releases&lt;br/&gt;- Artifact: &lt;service&gt;.jar&lt;br/&gt;- Hash: &lt;service&gt;.jar.sha256&lt;br/&gt;- Tag: &lt;service&gt;-v&lt;run_number&gt;\&quot;]\n        end\n        subgraph Runner [\&quot;GitHub Actions Runner (Ubuntu Latest)\&quot;]\n            subgraph CIWf [\&quot;CI Workflow (paths filter + concurrency theo service)\&quot;]\n                CIPR[\&quot;CI trên Push / Pull Request&lt;br/&gt;./mvnw clean verify&lt;br/&gt;(không phát hành)\&quot;]\n                CIMain[\&quot;CI chạy trên main sau merge / dispatch&lt;br/&gt;./mvnw clean verify\&quot;]\n            end\n            subgraph CDWf [\&quot;CD Workflow (tự động khi CI main xanh)\&quot;]\n                BuildJar[\&quot;Build / Package Runnable JAR\&quot;]\n                Smoke[\&quot;Smoke Test trên Runner:&lt;br/&gt;1. Khởi chạy ngầm: java -jar&lt;br/&gt;2. Polling GET /health&lt;br/&gt;(yêu cầu HTTP 200 trong 60s)&lt;br/&gt;3. Tắt tiến trình\&quot;]\n                Publisher[\&quot;GitHub Release Publisher&lt;br/&gt;(GITHUB_TOKEN: contents:write)\&quot;]\n            end\n        end\n    end\n\n    %% ===== Hạ tầng dùng chung / cục bộ =====\n    subgraph Infra [\&quot;Hạ Tầng Dữ Liệu &amp; Broker (Dùng chung / Cục bộ)\&quot;]\n        DBServer[(\&quot;Database Server (SQL Server)&lt;br/&gt;AuthDB, ContentDB, JobDB,&lt;br/&gt;TranslationDB, MediaDB\&quot;)]\n        Rabbit[\&quot;RabbitMQ Message Broker&lt;br/&gt;(AMQP TCP 5672, Mgmt 15672)\&quot;]\n        S3[(\&quot;S3-Compatible Object Storage&lt;br/&gt;(File âm thanh MP3)\&quot;)]\n    end\n\n    %% ===== Dịch vụ bên thứ ba =====\n    subgraph Ext [\&quot;Dịch Vụ Bên Thứ Ba\&quot;]\n        TransProv[\&quot;Third-party Translation Provider\&quot;]\n        TTSProv[\&quot;Third-party TTS Provider\&quot;]\n    end\n\n    %% ===== Luồng CI/CD =====\n    DevPC --&gt;|\&quot;1. Push code / mở Pull Request\&quot;| PR\n    PR --&gt;|\&quot;2. Kích hoạt CI\&quot;| CIPR\n    CIPR --&gt;|\&quot;3. CI xanh: đủ điều kiện merge&lt;br/&gt;(CI lỗi: chặn merge)\&quot;| PR\n    PR --&gt;|\&quot;4. Merge vào main\&quot;| CIMain\n    DevOpsPC -.-&gt;|\&quot;workflow_dispatch từ main&lt;br/&gt;(Chạy lại pipeline / phát hành lại service,&lt;br/&gt;bắt buộc vẫn qua CI main trước)\&quot;| CIMain\n    CIMain --&gt;|\&quot;5. CI main xanh: CD kích hoạt&lt;br/&gt;(CI lỗi: dừng, không chạy CD)\&quot;| BuildJar\n    BuildJar --&gt; Smoke\n    Smoke --&gt;|\&quot;HTTP 200: Đạt&lt;br/&gt;(Không đạt: hủy phát hành)\&quot;| Publisher\n    Publisher --&gt;|\&quot;6. Xuất bản JAR + SHA256\&quot;| Releases\n    Releases --&gt;|\&quot;7. Thành viên tải JAR về máy\&quot;| JRE\n\n    %% ===== Kết nối Database (JDBC/TCP) =====\n    JarAuth --&gt;|\&quot;JDBC / TCP (AuthDB)\&quot;| DBServer\n    JarContent --&gt;|\&quot;JDBC / TCP (ContentDB)\&quot;| DBServer\n    JarNarr --&gt;|\&quot;JDBC / TCP (JobDB)\&quot;| DBServer\n    JarTrans --&gt;|\&quot;JDBC / TCP (TranslationDB)\&quot;| DBServer\n    JarTTS --&gt;|\&quot;JDBC / TCP (MediaDB)\&quot;| DBServer\n\n    %% ===== Kết nối Message Broker (AMQP 5672) =====\n    JarContent --&gt;|\&quot;AMQP TCP 5672 (Publish events)\&quot;| Rabbit\n    JarNarr --&gt;|\&quot;AMQP TCP 5672 (Pub/Sub jobs &amp; results)\&quot;| Rabbit\n    JarTrans --&gt;|\&quot;AMQP TCP 5672 (Consume / Publish)\&quot;| Rabbit\n    JarTTS --&gt;|\&quot;AMQP TCP 5672 (Consume / Publish)\&quot;| Rabbit\n\n    %% ===== Kết nối Storage &amp; Providers =====\n    JarTTS --&gt;|\&quot;HTTPS S3 API: Upload MP3\&quot;| S3\n    JarTrans --&gt;|\&quot;HTTPS / REST (Retry max 3 sau lần đầu)\&quot;| TransProv\n    JarTTS --&gt;|\&quot;HTTPS / REST (Retry max 3 sau lần đầu)\&quot;| TTSProv&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="H8PVRnIFWRfCx-oVY-B_-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
