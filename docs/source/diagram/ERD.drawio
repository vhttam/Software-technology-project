<mxfile host="app.diagrams.net">
  <diagram name="Trang-1" id="P35uQ_3pQjRm5TQpLIW6">
    <mxGraphModel dx="3121" dy="1806" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ===== AUTH DB =====\n    USERS {\n        uuid user_id PK\n        varchar username UK\n        varchar name\n        varchar password_hash \&quot;bcrypt\&quot;\n        varchar role \&quot;CONTENT_ADMIN\&quot;\n        int failed_login_count \&quot;lock at 5\&quot;\n        datetime locked_until \&quot;NULL\&quot;\n        varchar refresh_token_hash \&quot;NULL\&quot;\n        datetime refresh_token_expires_at \&quot;NULL\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    %% ===== CONTENT DB =====\n    POINTS_OF_INTEREST {\n        uuid poi_id PK\n        varchar name\n        varchar description \&quot;NULL\&quot;\n        varchar qr_code UK \&quot;immutable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n    CONTENTS {\n        uuid content_id PK\n        uuid poi_id FK \&quot;unique where is_deleted = false\&quot;\n        uuid created_by \&quot;ref USERS\&quot;\n        boolean is_deleted \&quot;soft delete\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n    CONTENT_VERSIONS {\n        uuid content_id PK, FK\n        int version PK \&quot;immutable\&quot;\n        varchar title\n        varchar source_lang\n        text text_content\n        uuid created_by \&quot;ref USERS\&quot;\n        datetime created_at\n    }\n    CONTENT_OUTBOX_EVENTS {\n        uuid event_id PK\n        varchar aggregate_type\n        uuid aggregate_id\n        varchar routing_key\n        text payload\n        varchar correlation_id\n        int schema_version\n        datetime occurred_at\n        datetime published_at \&quot;NULL\&quot;\n    }\n\n    %% ===== JOB DB =====\n    JOBS {\n        uuid job_id PK\n        uuid content_id \&quot;ref CONTENT_VERSIONS\&quot;\n        int version \&quot;ref CONTENT_VERSIONS\&quot;\n        varchar status\n        uuid retry_of_job_id FK \&quot;NULL\&quot;\n        varchar correlation_id\n        uuid created_by \&quot;ref USERS\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n    JOB_TARGETS {\n        uuid target_id PK\n        uuid job_id FK, UK \&quot;unique with target_lang\&quot;\n        varchar target_lang UK\n        varchar voice_id \&quot;ref SUPPORTED_VOICES\&quot;\n        varchar status\n        uuid translation_id \&quot;NULL\&quot;\n        uuid audio_id \&quot;NULL\&quot;\n        varchar error_code \&quot;NULL\&quot;\n        datetime created_at\n        datetime updated_at \&quot;timeout check\&quot;\n    }\n    IDEMPOTENCY_KEYS {\n        uuid user_id PK\n        varchar operation_name PK\n        varchar idempotency_key PK\n        varchar request_hash\n        uuid job_id FK, UK\n        datetime created_at\n        datetime expires_at\n    }\n    NARRATION_OUTBOX_EVENTS {\n        uuid event_id PK\n        varchar aggregate_type\n        uuid aggregate_id\n        varchar routing_key\n        text payload\n        varchar correlation_id\n        int schema_version\n        datetime occurred_at\n        datetime published_at \&quot;NULL\&quot;\n    }\n\n    %% ===== TRANSLATION DB =====\n    TRANSLATIONS {\n        uuid translation_id PK\n        uuid content_id UK \&quot;unique with version, target_lang\&quot;\n        int version UK\n        varchar target_lang UK\n        text text_content\n        datetime created_at\n    }\n    TRANSLATION_CANCELLED_JOBS {\n        uuid job_id PK\n        datetime cancelled_at\n        datetime expires_at \&quot;TTL 48h\&quot;\n    }\n\n    %% ===== MEDIA DB =====\n    SUPPORTED_VOICES {\n        varchar voice_id PK\n        varchar lang\n        varchar description \&quot;NULL\&quot;\n        boolean is_active\n    }\n    AUDIOS {\n        uuid audio_id PK\n        uuid translation_id UK \&quot;unique with voice_id\&quot;\n        varchar voice_id FK, UK\n        varchar object_key \&quot;no signed URL\&quot;\n        int duration_seconds\n        bigint file_size_bytes\n        datetime created_at\n    }\n    TTS_CANCELLED_JOBS {\n        uuid job_id PK\n        datetime cancelled_at\n        datetime expires_at \&quot;TTL 48h\&quot;\n    }\n\n    %% ===== PHYSICAL FK (same DB) =====\n    POINTS_OF_INTEREST ||--o{ CONTENTS : \&quot;poi_id\&quot;\n    CONTENTS ||--|{ CONTENT_VERSIONS : \&quot;content_id\&quot;\n    JOBS ||--|{ JOB_TARGETS : \&quot;job_id\&quot;\n    JOBS |o--o{ JOBS : \&quot;retry_of_job_id\&quot;\n    JOBS ||--o| IDEMPOTENCY_KEYS : \&quot;job_id\&quot;\n    SUPPORTED_VOICES ||--o{ AUDIOS : \&quot;voice_id\&quot;\n\n    %% ===== LOGICAL REF (cross-service, no FK) =====\n    USERS ||..o{ CONTENTS : \&quot;created_by\&quot;\n    USERS ||..o{ JOBS : \&quot;created_by\&quot;\n    CONTENT_VERSIONS ||..o{ JOBS : \&quot;content_id, version\&quot;\n    CONTENT_VERSIONS ||..o{ TRANSLATIONS : \&quot;content_id, version\&quot;\n    TRANSLATIONS ||..o{ AUDIOS : \&quot;translation_id\&quot;\n    SUPPORTED_VOICES ||..o{ JOB_TARGETS : \&quot;voice_id\&quot;\n    TRANSLATIONS |o..o{ JOB_TARGETS : \&quot;translation_id\&quot;\n    AUDIOS |o..o{ JOB_TARGETS : \&quot;audio_id\&quot;\n    JOBS ||..o| TRANSLATION_CANCELLED_JOBS : \&quot;job_id\&quot;\n    JOBS ||..o| TTS_CANCELLED_JOBS : \&quot;job_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="0rtkVwCT1KKv9Cbq3NVw-1">
