        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\&quot;er\&quot;: {\&quot;useMaxWidth\&quot;: false, \&quot;minEntityWidth\&quot;: 120, \&quot;minEntityHeight\&quot;: 60, \&quot;entityPadding\&quot;: 12}, \&quot;themeVariables\&quot;: {\&quot;fontSize\&quot;: \&quot;13px\&quot;, \&quot;fontFamily\&quot;: \&quot;Segoe UI, Arial, sans-serif\&quot;}}}%%\nerDiagram\n    %% ERD — He thong thuyet minh tu dong da ngon ngu · 19 bang / 5 CSDL\n    %% ===== authdb — Auth Service (Flyway V1–V2) — 3 bảng =====\n    AUTH_USERS {\n        varchar user_id PK \&quot;VARCHAR(36)\&quot;\n        varchar username UK \&quot;VARCHAR(80)\&quot;\n        varchar name \&quot;VARCHAR(200)\&quot;\n        varchar role \&quot;VARCHAR(40)\&quot;\n        varchar status \&quot;VARCHAR(20)\&quot;\n        varchar password_hash \&quot;VARCHAR(100)\&quot;\n        int failed_login_count \&quot;INT\&quot;\n        varchar locked_until \&quot;VARCHAR(35)\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n        varchar updated_at \&quot;VARCHAR(35)\&quot;\n    }\n    AUTH_REFRESH_TOKENS {\n        varchar token_id PK \&quot;VARCHAR(36)\&quot;\n        varchar user_id FK \&quot;VARCHAR(36)\&quot;\n        varchar token_hash UK \&quot;VARCHAR(64)\&quot;\n        varchar expires_at \&quot;VARCHAR(35)\&quot;\n        bit revoked \&quot;BIT\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n    }\n    AUTH_AUDIT_LOGS {\n        varchar log_id PK \&quot;VARCHAR(36)\&quot;\n        varchar action \&quot;VARCHAR(80)\&quot;\n        varchar actor_id \&quot;VARCHAR(36)\&quot;\n        varchar target_id \&quot;VARCHAR(36)\&quot;\n        varchar details \&quot;VARCHAR(1000)\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n    }\n    %% ===== contentdb — Content Service (Flyway V1–V3) — 4 bảng =====\n    CONTENT_POINTS_OF_INTEREST {\n        varchar poi_id PK \&quot;VARCHAR(36)\&quot;\n        varchar name \&quot;VARCHAR(255)\&quot;\n        varchar description \&quot;VARCHAR(2000)\&quot;\n        varchar qr_code UK \&quot;VARCHAR(100)\&quot;\n        decimal latitude \&quot;DECIMAL(10,8)\&quot;\n        decimal longitude \&quot;DECIMAL(11,8)\&quot;\n        int trigger_radius \&quot;INT\&quot;\n        bit is_deleted \&quot;BIT\&quot;\n        varchar deleted_at \&quot;VARCHAR(35)\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n        varchar updated_at \&quot;VARCHAR(35)\&quot;\n    }\n    CONTENT_CONTENTS {\n        varchar content_id PK \&quot;VARCHAR(36)\&quot;\n        varchar poi_id FK \&quot;VARCHAR(36)\&quot;\n        int current_version \&quot;INT\&quot;\n        bit is_deleted \&quot;BIT\&quot;\n        varchar created_by \&quot;VARCHAR(36)\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n        varchar updated_at \&quot;VARCHAR(35)\&quot;\n    }\n    CONTENT_CONTENT_VERSIONS {\n        varchar content_id PK, FK \&quot;VARCHAR(36)\&quot;\n        int version PK \&quot;INT\&quot;\n        varchar title \&quot;VARCHAR(255)\&quot;\n        varchar source_lang \&quot;VARCHAR(20)\&quot;\n        varchar text_content \&quot;VARCHAR(MAX)\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n    }\n    CONTENT_OUTBOX_EVENTS {\n        varchar event_id PK \&quot;VARCHAR(36)\&quot;\n        varchar routing_key \&quot;VARCHAR(80)\&quot;\n        varchar payload \&quot;VARCHAR(4000)\&quot;\n        varchar correlation_id \&quot;VARCHAR(100)\&quot;\n        varchar occurred_at \&quot;VARCHAR(35)\&quot;\n        bit published \&quot;BIT\&quot;\n    }\n    %% ===== narrationdb — Narration Service (Flyway V1–V2) — 6 bảng =====\n    NARR_JOBS {\n        varchar job_id PK \&quot;VARCHAR(36)\&quot;\n        varchar content_id \&quot;VARCHAR(36)\&quot;\n        int version \&quot;INT\&quot;\n        varchar status \&quot;VARCHAR(30)\&quot;\n        varchar created_by \&quot;VARCHAR(36)\&quot;\n        varchar correlation_id \&quot;VARCHAR(100)\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n        varchar updated_at \&quot;VARCHAR(35)\&quot;\n    }\n    NARR_IDEMPOTENCY_RECORDS {\n        varchar record_id PK \&quot;VARCHAR(36)\&quot;\n        varchar user_id \&quot;VARCHAR(36)\&quot;\n        varchar operation \&quot;VARCHAR(80)\&quot;\n        varchar idempotency_key \&quot;VARCHAR(255)\&quot;\n        varchar request_hash \&quot;VARCHAR(64)\&quot;\n        varchar job_id \&quot;VARCHAR(36)\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n        varchar expires_at \&quot;VARCHAR(35)\&quot;\n    }\n    NARR_OUTBOX_EVENTS {\n        varchar event_id PK \&quot;VARCHAR(36)\&quot;\n        varchar exchange_name \&quot;VARCHAR(80)\&quot;\n        varchar routing_key \&quot;VARCHAR(80)\&quot;\n        varchar payload \&quot;VARCHAR(4000)\&quot;\n        varchar correlation_id \&quot;VARCHAR(100)\&quot;\n        varchar occurred_at \&quot;VARCHAR(35)\&quot;\n        bit published \&quot;BIT\&quot;\n    }\n    NARR_JOB_TARGETS {\n        varchar target_id PK \&quot;VARCHAR(36)\&quot;\n        varchar job_id FK \&quot;VARCHAR(36)\&quot;\n        varchar lang \&quot;VARCHAR(20)\&quot;\n        varchar voice_id \&quot;VARCHAR(100)\&quot;\n        varchar status \&quot;VARCHAR(30)\&quot;\n        varchar error_code \&quot;VARCHAR(40)\&quot;\n        varchar error_message \&quot;VARCHAR(500)\&quot;\n        varchar translation_id \&quot;VARCHAR(36)\&quot;\n        varchar audio_id \&quot;VARCHAR(36)\&quot;\n        varchar updated_at \&quot;VARCHAR(35)\&quot;\n    }\n    NARR_JOB_CREATION_LOCKS {\n        varchar lock_key PK \&quot;VARCHAR(120)\&quot;\n    }\n    NARR_EVENT_ATTEMPTS {\n        varchar event_id PK \&quot;VARCHAR(36)\&quot;\n        int attempts \&quot;INT\&quot;\n        varchar updated_at \&quot;VARCHAR(35)\&quot;\n    }\n    %% ===== translationdb — Translation Service (Flyway V1) — 3 bảng =====\n    TRANS_TRANSLATIONS {\n        varchar translation_id PK \&quot;VARCHAR(36)\&quot;\n        varchar content_id \&quot;VARCHAR(36)\&quot;\n        int version \&quot;INT\&quot;\n        varchar lang \&quot;VARCHAR(20)\&quot;\n        varchar text_content \&quot;VARCHAR(MAX)\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n    }\n    TRANS_CANCELLED_JOBS {\n        varchar job_id PK \&quot;VARCHAR(36)\&quot;\n        varchar expires_at \&quot;VARCHAR(35)\&quot;\n    }\n    TRANS_EVENT_ATTEMPTS {\n        varchar event_id PK \&quot;VARCHAR(36)\&quot;\n        int attempts \&quot;INT\&quot;\n        varchar updated_at \&quot;VARCHAR(35)\&quot;\n    }\n    %% ===== ttsdb — TTS Service (Flyway V1) — 3 bảng =====\n    TTS_AUDIOS {\n        varchar audio_id PK \&quot;VARCHAR(36)\&quot;\n        varchar translation_id \&quot;VARCHAR(36)\&quot;\n        varchar voice_id \&quot;VARCHAR(100)\&quot;\n        varchar object_key \&quot;VARCHAR(500)\&quot;\n        int duration_seconds \&quot;INT\&quot;\n        bigint size_bytes \&quot;BIGINT\&quot;\n        varchar created_at \&quot;VARCHAR(35)\&quot;\n    }\n    TTS_CANCELLED_JOBS {\n        varchar job_id PK \&quot;VARCHAR(36)\&quot;\n        varchar expires_at \&quot;VARCHAR(35)\&quot;\n    }\n    TTS_EVENT_ATTEMPTS {\n        varchar event_id PK \&quot;VARCHAR(36)\&quot;\n        int attempts \&quot;INT\&quot;\n        varchar updated_at \&quot;VARCHAR(35)\&quot;\n    }\n\n    %% ===== Quan hệ: nét liền = khóa ngoại thật (cùng CSDL) =====\n    AUTH_USERS ||--o{ AUTH_REFRESH_TOKENS : \&quot;1 : N\&quot;\n    AUTH_USERS ||..o{ AUTH_AUDIT_LOGS : \&quot;actor_id (logic)\&quot;\n    CONTENT_POINTS_OF_INTEREST ||--o{ CONTENT_CONTENTS : \&quot;1 : N\&quot;\n    CONTENT_CONTENTS ||--o{ CONTENT_CONTENT_VERSIONS : \&quot;1 : N\&quot;\n    NARR_JOBS ||--o{ NARR_JOB_TARGETS : \&quot;1 : N\&quot;\n    NARR_IDEMPOTENCY_RECORDS ||..o{ NARR_JOBS : \&quot;job_id (logic)\&quot;\n    NARR_JOBS ||..o{ CONTENT_CONTENTS : \&quot;content_id (logic)\&quot;\n    NARR_JOB_TARGETS ||..o{ TRANS_TRANSLATIONS : \&quot;translation_id (logic)\&quot;\n    NARR_JOB_TARGETS ||..o{ TTS_AUDIOS : \&quot;audio_id (logic)\&quot;\n    TTS_AUDIOS ||..o{ TRANS_TRANSLATIONS : \&quot;translation_id (logic)\&quot;\n\n    %% ===== Chú giải =====\n    %% PK = khóa chính · FK = khóa ngoại · UK = duy nhất\n    %% Nét đứt + (logic) = tham chiếu chéo service, KHÔNG có FK vật lý\n    %% vì mỗi service sở hữu CSDL riêng (database-per-service)\n    %% Kiểu trong ngoặc kép là kiểu gốc trong Flyway migration\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="kFaEFXQq-WIMdS2b-zAd-1">
