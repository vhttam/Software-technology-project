  <diagram name="Trang-1" id="egIGsw6923V1QkG7mdRj">
    <mxGraphModel dx="3679" dy="2129" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
