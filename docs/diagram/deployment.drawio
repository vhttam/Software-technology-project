        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\&quot;flowchart\&quot;: {\&quot;curve\&quot;: \&quot;linear\&quot;, \&quot;nodeSpacing\&quot;: 40, \&quot;rankSpacing\&quot;: 65, \&quot;useMaxWidth\&quot;: false}, \&quot;themeVariables\&quot;: {\&quot;fontSize\&quot;: \&quot;13px\&quot;, \&quot;fontFamily\&quot;: \&quot;Segoe UI, Arial, sans-serif\&quot;}}}%%\nflowchart TB\n  classDef client fill:#DBEAFE,stroke:#2563EB,stroke-width:1px,color:#1E3A8A\n  classDef web fill:#DCFCE7,stroke:#16A34A,stroke-width:1px,color:#14532D\n  classDef svc fill:#FEF3C7,stroke:#D97706,stroke-width:1px,color:#78350F\n  classDef data fill:#EDE9FE,stroke:#7C3AED,stroke-width:1px,color:#4C1D95\n  classDef ext fill:#FEE2E2,stroke:#DC2626,stroke-width:1px,color:#7F1D1D\n  classDef note fill:#F3F4F6,stroke:#6B7280,stroke-width:1px,color:#374151,stroke-dasharray:4 3\n\n  subgraph CL[\&quot;Người dùng\&quot;]\n    ADMIN[\&quot;Máy tính quản trị&lt;br/&gt;Chrome / Edge&lt;br/&gt;Web Admin SPA (React 18)\&quot;]\n    VISITOR[\&quot;Điện thoại du khách&lt;br/&gt;Quét mã QR tại điểm tham quan&lt;br/&gt;Nghe audio qua Signed URL :8085\&quot;]\n  end\n\n  subgraph HOST[\&quot;MÁY CHỦ TRIỂN KHAI — Docker Host (Docker Desktop / Linux) · Docker Compose · network cnpm_default\&quot;]\n    subgraph WEBL[\&quot;Lớp Web / Edge\&quot;]\n      WEB[\&quot;web — nginx:alpine · :3000 → :80&lt;br/&gt;SPA tĩnh (dist/) · proxy REST + SSE tới API Gateway\&quot;]\n    end\n\n    subgraph APPL[\&quot;Lớp ứng dụng — JDK 17 · Spring Boot 3.5\&quot;]\n      GW[\&quot;api-gateway :8080 — Spring Cloud Gateway (WebFlux)&lt;br/&gt;Xác thực JWT (JWKS) · RBAC · rate-limit · SSE · X-Service-Token\&quot;]\n      A1[\&quot;auth-service :8081&lt;br/&gt;authdb · JWT · BCrypt · audit\&quot;]\n      A2[\&quot;content-service :8082&lt;br/&gt;contentdb · POI · QR · phiên bản\&quot;]\n      A3[\&quot;narration-service :8083&lt;br/&gt;narrationdb · điều phối job · idempotency\&quot;]\n      A4[\&quot;