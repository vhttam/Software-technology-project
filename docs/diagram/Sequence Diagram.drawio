<mxfile host="app.diagrams.net">
  <diagram name="Trang-1" id="dbluFn09hmG87UqObHzw">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Admin as Quản trị nội dung\n    participant GW as API Gateway\n    participant CS as Content Service\n    participant CDB as Content DB\n    participant NS as Narration Service\n    participant JDB as Job DB\n    participant TTS as TTS Service\n    participant MB as RabbitMQ (narration.events)\n\n    Admin-&gt;&gt;GW: POST /api/v1/pois/quick-create-with-job (Idempotency-Key, Bearer JWT)\n    \n    %% Kiểm tra Auth &amp; Headers\n    alt JWT không hợp lệ hoặc hết hạn\n        GW--&gt;&gt;Admin: 401 Unauthorized\n    else Vai trò không phải CONTENT_ADMIN\n        GW--&gt;&gt;Admin: 403 Forbidden\n    else Thiếu Idempotency-Key\n        GW--&gt;&gt;Admin: 400 Bad Request (IDEMPOTENCY_KEY_REQUIRED)\n    end\n\n    GW-&gt;&gt;GW: Xác thực Asymmetric JWT (Public Key)&lt;br/&gt;Sinh X-Correlation-ID\n    GW-&gt;&gt;CS: POST /api/v1/pois/quick-create-with-job&lt;br/&gt;(X-Correlation-ID, X-User-Id, X-User-Role, Idempotency-Key)\n\n    %% Validate Content Service\n    alt Dữ liệu không hợp lệ (tọa độ ngoài phạm vi, tên rỗng, văn bản &gt; 10.000 ký tự)\n        CS--&gt;&gt;GW: 400 Bad Request (INVALID_COORDINATES / VALIDATION_ERROR)\n        GW--&gt;&gt;Admin: 400 Bad Request\n    end\n\n    loop Sinh mã qr_code (tối đa 3 lần nếu trùng)\n        CS-&gt;&gt;CS: Sinh ngẫu nhiên qr_code duy nhất\n    end\n    note over CS: Nếu sau 3 lần vẫn trùng -&gt; trả HTTP 500\n\n    %% Local DB Transaction\n    rect rgb(240, 248, 255)\n        note over CS, CDB: 1 Local Database Transaction (Commit ngay, không giữ lock sang REST)\n        CS-&gt;&gt;CDB: BEGIN TRANSACTION\n        CS-&gt;&gt;CDB: INSERT INTO POINTS_OF_INTEREST (poi_id, name, description, latitude, longitude, trigger_radius, qr_code)\n        CS-&gt;&gt;CDB: INSERT INTO CONTENTS (content_id, version=1, title, source_lang, text_content, created_by)\n        CS-&gt;&gt;CDB: COMMIT TRANSACTION\n    end\n\n    CS-&gt;&gt;MB: Publish event content.updated (contentId, version: 1)\n\n    %% Gọi REST sang Narration Service\n    CS-&gt;&gt;NS: POST /internal/jobs (X-Service-Token, X-Correlation-ID, Idempotency-Key, contentId, targets[])\n\n    critical Gọi Narration Service kích hoạt Job\n        NS-&gt;&gt;NS: Kiểm tra Idempotency-Key\n        alt Cùng Idempotency-Key nhưng payload khác\n            NS--&gt;&gt;CS: 409 Conflict (IDEMPOTENCY_KEY_REUSED)\n        end\n\n        NS-&gt;&gt;TTS: GET /internal/voices (X-Service-Token)\n        TTS--&gt;&gt;NS: 200 OK (Danh mục supportedVoices)\n        NS-&gt;&gt;NS: Kiểm tra targets[] hợp lệ theo danh mục giọng đọc\n\n        NS-&gt;&gt;CS: GET /internal/contents/{contentId}/current (X-Service-Token)\n        CS--&gt;&gt;NS: 200 OK {\&quot;contentId\&quot;: \&quot;c-xxx\&quot;, \&quot;version\&quot;: 1, \&quot;sourceLang\&quot;: \&quot;vi\&quot;}\n\n        NS-&gt;&gt;JDB: BEGIN TRANSACTION (UPDLOCK contentId, version)\n        NS-&gt;&gt;JDB: Kiểm tra job trùng PENDING/PROCESSING (contentId, version, targetLang)\n        alt Có job đang chạy trùng target và không có retryOfJobId hợp lệ\n            NS-&gt;&gt;JDB: ROLLBACK\n            NS--&gt;&gt;CS: 409 Conflict (ACTIVE_JOB_EXISTS, details.jobIds[])\n        else Hợp lệ\n            NS-&gt;&gt;JDB: INSERT INTO JOBS (job_id, content_id, version, status=&#39;PENDING&#39;, correlation_id, created_by)\n            NS-&gt;&gt;JDB: INSERT INTO JOB_TARGETS (job_id, target_lang, voice_id, status=&#39;PENDING&#39;)\n            NS-&gt;&gt;JDB: COMMIT TRANSACTION\n            NS--&gt;&gt;CS: 202 Accepted (jobId, status: PENDING, targets[])\n        end\n\n        CS--&gt;&gt;GW: 201 Created (poi, content, job)\n        GW--&gt;&gt;Admin: 201 Created (poiId, qrCode, qrImageUrl, jobId)\n\n        %% Narration Service chuyển trạng thái và phát sự kiện\n        NS-&gt;&gt;JDB: UPDATE JOBS SET status=&#39;PROCESSING&#39;; UPDATE JOB_TARGETS SET status=&#39;TRANSLATING&#39;\n        NS-&gt;&gt;MB: Publish narration.requested riêng cho từng target\n        NS-&gt;&gt;GW: POST /internal/callbacks/job-progress\n        GW--&gt;&gt;Admin: SSE Event: job.progress (UC8 bước 9: hiển thị tiến độ thời gian thực)\n\n    option Narration Service lỗi hoặc timeout (503 / HTTP 5xx)\n        note over CS, CDB: Giao dịch bù trừ (Compensating Transaction) đảm bảo tính All-or-Nothing\n        CS-&gt;&gt;CDB: DELETE FROM CONTENTS WHERE content_id = c-xxx AND version = 1\n        CS-&gt;&gt;CDB: DELETE FROM POINTS_OF_INTEREST WHERE poi_id = p-xxx\n        CS--&gt;&gt;GW: 503 Service Unavailable (NARRATION_SERVICE_UNAVAILABLE)\n        GW--&gt;&gt;Admin: 503 Service Unavailable (Giữ nguyên dữ liệu để người dùng thử lại)\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="QcECqs9Mc7QtAx5_uKD7-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
