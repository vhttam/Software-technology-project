  <diagram name="Trang-1" id="l3BMuLXhxdEfmURo2X4v">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TB\n    %% Client\n    subgraph ClientBox [\&quot;Client\&quot;]\n        ClientApp[\&quot;Client (Trình duyệt web / MapLibre / Service Worker)\&quot;]\n    end\n\n    %% Gateway\n    Gateway[\&quot;API Gateway&lt;br/&gt;(Định tuyến, xác thực Asymmetric JWT Public Key, sinh X-Correlation-ID, SSE)\&quot;]\n\n    %% Microservices\n    AuthSvc[\&quot;Auth Service\&quot;]\n    ContentSvc[\&quot;Content Service\&quot;]\n    NarrationSvc[\&quot;Narration Service (Điều phối Job)\&quot;]\n    TransSvc[\&quot;Translation Service\&quot;]\n    TTSSvc[\&quot;TTS Service\&quot;]\n\n    %% Databases &amp; Storages\n    AuthDB[(\&quot;Auth DB\&quot;)]\n    ContentDB[(\&quot;Content DB (PostGIS)\&quot;)]\n    RedisCache[(\&quot;Redis Cache (ZSET presence)\&quot;)]\n    JobDB[(\&quot;Job DB\&quot;)]\n    TransDB[(\&quot;Translation DB\&quot;)]\n    MediaDB[(\&quot;Media DB\&quot;)]\n    ObjectStore[(\&quot;Object Storage (MP3)\&quot;)]\n\n    %% Connect DBs\n    AuthSvc --- AuthDB\n    ContentSvc --- ContentDB\n    ContentSvc --- RedisCache\n    NarrationSvc --- JobDB\n    TransSvc --- TransDB\n    TTSSvc --- MediaDB\n\n    %% External\n    TransProvider[\&quot;Translation Provider (bên ngoài)\&quot;]\n    TTSProvider[\&quot;TTS Provider (bên ngoài)\&quot;]\n    TransSvc --&gt; TransProvider\n    TTSSvc --&gt; TTSProvider\n    TTSSvc --&gt; ObjectStore\n\n    %% CI/CD Component (B.4 / UC6)\n    subgraph CICDBox [\&quot;Quy trình CI/CD theo từng service (UC6 / B.4)\&quot;]\n        GHActions[\&quot;GitHub Actions Runner&lt;br/&gt;(paths filter, ./mvnw clean verify, smoke test GET /health)\&quot;]\n        GHReleases[\&quot;GitHub Releases&lt;br/&gt;(tag &lt;service&gt;-v&lt;run_number&gt;, JAR + SHA256)\&quot;]\n        GHActions --&gt;|Smoke test GET /health = 200| GHReleases\n    end\n\n    %% Client / Gateway\n    ClientApp --&gt;|HTTPS / REST| Gateway\n    Gateway -.-&gt;|SSE: /api/v1/jobs/{jobId}/events| ClientApp\n    ClientApp -.-&gt;|Phát MP3 qua Signed URL| ObjectStore\n\n    %% Gateway to Internal Services\n    Gateway --&gt;|GET /api/v1/auth/.well-known/jwks.json| AuthSvc\n    Gateway --&gt;|POST /api/v1/auth/login, refresh, logout, users| AuthSvc\n    Gateway --&gt;|GET /internal/pois, /current, /by-qr, /nearby, /card| ContentSvc\n    Gateway --&gt;|POST /api/v1/client/presence/heartbeat, GET online-count, GET /metrics| ContentSvc\n    Gateway --&gt;|GET /internal/narrations, GET /internal/narrations/{lang}| NarrationSvc\n    NarrationSvc -.-&gt;|POST /internal/callbacks/job-progress| Gateway\n\n    %% Internal REST calls\n    ContentSvc --&gt;|POST /internal/jobs| NarrationSvc\n    NarrationSvc --&gt;|GET /internal/contents/{contentId}/current| ContentSvc\n    NarrationSvc --&gt;|GET /internal/translations/{translationId}| TransSvc\n    NarrationSvc --&gt;|GET /internal/voices, GET /internal/audios/{audioId}/signed-url| TTSSvc\n    TransSvc --&gt;|GET /internal/contents/{contentId}/versions/{version}| ContentSvc\n    TTSSvc --&gt;|GET /internal/translations/{translationId}| TransSvc\n\n    %% Message Broker Layer with Explicit Queues and DLQs (B.3)\n    subgraph BrokerBox [\&quot;Message Broker (RabbitMQ)\&quot;]\n        direction TB\n        ExEvents[\&quot;Exchange: narration.events (Topic)\&quot;]\n        ExCancel[\&quot;Exchange: narration.cancel (Fanout)\&quot;]\n\n        QTransReq[\&quot;Queue: translation.q.requested\&quot;]\n        QTTSTransComp[\&quot;Queue: tts.q.translation-completed\&quot;]\n        QNarrTransComp[\&quot;Queue: narration.q.translation-completed\&quot;]\n        QNarrResults[\&quot;Queue: narration.q.results\&quot;]\n\n        DLQ_TransReq[\&quot;DLQ: translation.q.requested.dlq\&quot;]\n        DLQ_TTSTransComp[\&quot;DLQ: tts.q.translation-completed.dlq\&quot;]\n        DLQ_NarrTransComp[\&quot;DLQ: narration.q.translation-completed.dlq\&quot;]\n        DLQ_NarrResults[\&quot;DLQ: narration.q.results.dlq\&quot;]\n\n        ExEvents --&gt;|narration.requested| QTransReq\n        ExEvents --&gt;|translation.completed (Bản sao TTS)| QTTSTransComp\n        ExEvents --&gt;|translation.completed (Bản sao Narration)| QNarrTransComp\n        ExEvents --&gt;|translation.failed, tts.completed, tts.failed| QNarrResults\n\n        QTransReq -.-&gt;|nack / lỗi định dạng / lỗi nội bộ| DLQ_TransReq\n        QTTSTransComp -.-&gt;|nack| DLQ_TTSTransComp\n        QNarrTransComp -.-&gt;|nack| DLQ_NarrTransComp\n        QNarrResults -.-&gt;|nack| DLQ_NarrResults\n    end\n\n    %% Publish / Consume\n    ContentSvc --&gt;|publish: content.updated, content.deleted| ExEvents\n    NarrationSvc --&gt;|publish: narration.requested| ExEvents\n    NarrationSvc --&gt;|publish: narration.cancelled| ExCancel\n\n    QTransReq --&gt;|consume| TransSvc\n    QTTSTransComp --&gt;|consume| TTSSvc\n    QNarrTransComp --&gt;|consume| NarrationSvc\n    QNarrResults --&gt;|consume| NarrationSvc\n    ExCancel --&gt;|consume| TransSvc\n    ExCancel --&gt;|consume| TTSSvc&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nhqjtalwApti7WjqExuh-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
